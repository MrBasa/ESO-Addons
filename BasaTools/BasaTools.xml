<GuiXml>
    <Controls>
        <Control name="BasaToolsTab" virtual="true" mouseEnabled="true">
            <Dimensions x="150" y="32" />
            <Controls>
                <Texture name="$(parent)Icon">
                    <Anchor point="LEFT" offsetX="2" />
                    <Dimensions x="28" y="28" />
                </Texture>
                <Label name="$(parent)Label" font="ZoFontHeader3" mouseEnabled="false">
                    <Anchor point="LEFT" relativeTo="$(parent)Icon" relativePoint="RIGHT" offsetX="6" />
                    <Dimensions x="114" y="28" />
                </Label>
            </Controls>
        </Control>

        <Control name="BasaToolsOutputLineRow" virtual="true" mouseEnabled="false">
            <Dimensions y="22" />
            <Anchor point="RIGHT" relativeTo="$(parent)" />
            <Controls>
                <Label name="$(parent)Line" font="ZoFontGame" wrapMode="ELLIPSIS">
                    <Anchor point="TOPLEFT" offsetX="4" offsetY="2" />
                    <Anchor point="BOTTOMRIGHT" offsetX="-4" offsetY="-2" />
                </Label>
            </Controls>
        </Control>

        <Control name="BasaToolsHelpRow" virtual="true" mouseEnabled="false">
            <Dimensions y="24" />
            <Anchor point="RIGHT" relativeTo="$(parent)" />
            <Controls>
                <Scroll name="$(parent)HClip">
                    <Anchor point="TOPLEFT" />
                    <Anchor point="BOTTOMRIGHT" />
                    <Controls>
                        <Control name="$(parent)Inner">
                            <Dimensions x="1100" y="24" />
                            <Anchor point="TOPLEFT" />
                            <Controls>
                                <Label name="$(parent)Action" font="ZoFontGame" wrapMode="ELLIPSIS" verticalAlignment="CENTER">
                                    <Anchor point="TOPLEFT" offsetX="4" offsetY="2" />
                                    <Dimensions x="160" y="20" />
                                </Label>
                                <Label name="$(parent)Slash" font="ZoFontGame" wrapMode="ELLIPSIS" verticalAlignment="CENTER">
                                    <Anchor point="TOPLEFT" relativeTo="$(parent)Action" relativePoint="TOPRIGHT" offsetX="8" />
                                    <Dimensions x="190" y="20" />
                                </Label>
                                <Label name="$(parent)Effect" font="ZoFontGame" wrapMode="ELLIPSIS" verticalAlignment="CENTER">
                                    <Anchor point="TOPLEFT" relativeTo="$(parent)Slash" relativePoint="TOPRIGHT" offsetX="8" />
                                    <Dimensions x="726" y="20" />
                                </Label>
                            </Controls>
                        </Control>
                    </Controls>
                </Scroll>
            </Controls>
        </Control>

        <Control name="BasaToolsWritMatchPanel" virtual="true">
            <Controls>
                <Button name="$(parent)Help" inherits="ZO_DefaultButton" text="Help">
                    <Anchor point="TOPLEFT" />
                    <Dimensions x="188" y="28" />
                    <OnClicked>BasaTools_ShowHelp("WritMatch")</OnClicked>
                    <OnMouseEnter>ZO_Tooltips_ShowTextTooltip(self, TOP, "What WritMatch is for and how each action works.")</OnMouseEnter>
                    <OnMouseExit>ZO_Tooltips_HideTextTooltip()</OnMouseExit>
                </Button>
                <Button name="$(parent)Reconcile" inherits="ZO_DefaultButton" text="Match writs">
                    <Anchor point="TOPLEFT" relativeTo="$(parent)Help" relativePoint="TOPRIGHT" offsetX="8" />
                    <Dimensions x="188" y="28" />
                    <OnClicked>BasaTools_RunWritMatch("reconcile")</OnClicked>
                    <OnMouseEnter>ZO_Tooltips_ShowTextTooltip(self, TOP, "Pair sealed backpack writs with crafted gear. Mark complete, queue leftover improves, list unmatched and orphans. Does not dequeue unmatched WritWorthy rows. Same as /writmatch.")</OnMouseEnter>
                    <OnMouseExit>ZO_Tooltips_HideTextTooltip()</OnMouseExit>
                </Button>
                <Button name="$(parent)Queues" inherits="ZO_DefaultButton" text="Show LLC queue">
                    <Anchor point="TOPLEFT" relativeTo="$(parent)Reconcile" relativePoint="TOPRIGHT" offsetX="8" />
                    <Dimensions x="188" y="28" />
                    <OnClicked>BasaTools_RunWritMatch("queues")</OnClicked>
                    <OnMouseEnter>ZO_Tooltips_ShowTextTooltip(self, TOP, "Dump every LibLazyCrafting job (addon, station, type, item). Same as /writmatch queues.")</OnMouseEnter>
                    <OnMouseExit>ZO_Tooltips_HideTextTooltip()</OnMouseExit>
                </Button>
                <Button name="$(parent)Crafts" inherits="ZO_DefaultButton" text="Clear LLC queue">
                    <Anchor point="TOPLEFT" relativeTo="$(parent)Queues" relativePoint="TOPRIGHT" offsetX="8" />
                    <Dimensions x="188" y="28" />
                    <OnClicked>BasaTools_RunWritMatch("crafts")</OnClicked>
                    <OnMouseEnter>ZO_Tooltips_ShowTextTooltip(self, TOP, "Clear WritWorthy queued flags and all craft-new LLC jobs (including provisioning/alchemy/enchanting). Keeps improvement jobs. Same as /writmatch crafts.")</OnMouseEnter>
                    <OnMouseExit>ZO_Tooltips_HideTextTooltip()</OnMouseExit>
                </Button>
                <Button name="$(parent)Kick" inherits="ZO_DefaultButton" text="Kick improve">
                    <Anchor point="TOPLEFT" relativeTo="$(parent)Help" relativePoint="BOTTOMLEFT" offsetY="8" />
                    <Dimensions x="188" y="28" />
                    <OnClicked>BasaTools_RunWritMatch("kick")</OnClicked>
                    <OnMouseEnter>ZO_Tooltips_ShowTextTooltip(self, TOP, "At a crafting station, start the next improve if LLC stopped after one. Same as /writmatch kick.")</OnMouseEnter>
                    <OnMouseExit>ZO_Tooltips_HideTextTooltip()</OnMouseExit>
                </Button>
                <Button name="$(parent)Orphans" inherits="ZO_DefaultButton" text="Drop orphan jobs">
                    <Anchor point="TOPLEFT" relativeTo="$(parent)Kick" relativePoint="TOPRIGHT" offsetX="8" />
                    <Dimensions x="188" y="28" />
                    <OnClicked>BasaTools_RunWritMatch("orphans")</OnClicked>
                    <OnMouseEnter>ZO_Tooltips_ShowTextTooltip(self, TOP, "Cancel LLC jobs whose sealed writ is no longer in the backpack. Same as /writmatch orphans.")</OnMouseEnter>
                    <OnMouseExit>ZO_Tooltips_HideTextTooltip()</OnMouseExit>
                </Button>
            </Controls>
        </Control>

        <Control name="BasaToolsLibScannerPanel" virtual="true">
            <Controls>
                <Button name="$(parent)Help" inherits="ZO_DefaultButton" text="Help">
                    <Anchor point="TOPLEFT" />
                    <Dimensions x="188" y="28" />
                    <OnClicked>BasaTools_ShowHelp("LibScanner")</OnClicked>
                    <OnMouseEnter>ZO_Tooltips_ShowTextTooltip(self, TOP, "What LibScanner is for and how each action works.")</OnMouseEnter>
                    <OnMouseExit>ZO_Tooltips_HideTextTooltip()</OnMouseExit>
                </Button>
                <Button name="$(parent)Scan" inherits="ZO_DefaultButton" text="Scan add-ons">
                    <Anchor point="TOPLEFT" relativeTo="$(parent)Help" relativePoint="TOPRIGHT" offsetX="8" />
                    <Dimensions x="188" y="28" />
                    <OnClicked>BasaTools_RunLibScanner("scan")</OnClicked>
                    <OnMouseEnter>ZO_Tooltips_ShowTextTooltip(self, TOP, "Run the dependency scan and show Versions / Libraries here. Same as /libscan.")</OnMouseEnter>
                    <OnMouseExit>ZO_Tooltips_HideTextTooltip()</OnMouseExit>
                </Button>
                <Button name="$(parent)Export" inherits="ZO_DefaultButton" text="Export TSV">
                    <Anchor point="TOPLEFT" relativeTo="$(parent)Scan" relativePoint="TOPRIGHT" offsetX="8" />
                    <Dimensions x="188" y="28" />
                    <OnClicked>BasaTools_RunLibScanner("export")</OnClicked>
                    <OnMouseEnter>ZO_Tooltips_ShowTextTooltip(self, TOP, "Scan and save a TSV snapshot to LibScanner SavedVariables. Same as /libscanexport.")</OnMouseEnter>
                    <OnMouseExit>ZO_Tooltips_HideTextTooltip()</OnMouseExit>
                </Button>
                <Button name="$(parent)CheckDebug" inherits="ZO_CheckButton">
                    <Anchor point="TOPLEFT" relativeTo="$(parent)Export" relativePoint="TOPRIGHT" offsetX="16" offsetY="2" />
                </Button>

                <Button name="$(parent)TabLibs" inherits="ZO_DefaultButton" text="Libraries">
                    <Anchor point="TOPLEFT" relativeTo="$(parent)Help" relativePoint="BOTTOMLEFT" offsetY="10" />
                    <Dimensions x="120" y="26" />
                    <OnClicked>LibScanner_SetTab("Libs")</OnClicked>
                </Button>
                <Button name="$(parent)TabVersions" inherits="ZO_DefaultButton" text="Versions">
                    <Anchor point="TOPLEFT" relativeTo="$(parent)TabLibs" relativePoint="TOPRIGHT" offsetX="8" />
                    <Dimensions x="120" y="26" />
                    <OnClicked>LibScanner_SetTab("Versions")</OnClicked>
                </Button>

                <Control name="$(parent)LibsPane" hidden="false">
                    <Anchor point="TOPLEFT" relativeTo="$(parent)TabLibs" relativePoint="BOTTOMLEFT" offsetY="8" />
                    <Anchor point="BOTTOMRIGHT" />
                    <Controls>
                        <Backdrop name="$(parent)Backdrop" inherits="ZO_MultiLineEditBackdrop_Keyboard">
                            <AnchorFill />
                            <Controls>
                                <EditBox name="$(parent)Edit" editEnabled="false" inherits="ZO_DefaultEditMultiLineForBackdrop" maxInputCharacters="50000" mouseEnabled="true" />
                            </Controls>
                        </Backdrop>
                    </Controls>
                </Control>

                <Control name="$(parent)VersionsPane" hidden="true">
                    <Anchor point="TOPLEFT" relativeTo="$(parent)TabLibs" relativePoint="BOTTOMLEFT" offsetY="8" />
                    <Anchor point="BOTTOMRIGHT" />
                    <Controls>
                        <Button name="$(parent)HdrName" text="Addon Name" font="ZoFontGameBold">
                            <Anchor point="TOPLEFT" offsetX="5" />
                            <Dimensions x="280" y="25" />
                            <OnClicked>LibScanner_SortBy("name")</OnClicked>
                        </Button>
                        <Button name="$(parent)HdrStatus" text="Is Up To Date?" font="ZoFontGameBold">
                            <Anchor point="TOPLEFT" relativeTo="$(parent)HdrName" relativePoint="TOPRIGHT" offsetX="10" />
                            <Dimensions x="130" y="25" />
                            <OnClicked>LibScanner_SortBy("status")</OnClicked>
                        </Button>
                        <Button name="$(parent)HdrVersion" text="Author Version" font="ZoFontGameBold">
                            <Anchor point="TOPLEFT" relativeTo="$(parent)HdrStatus" relativePoint="TOPRIGHT" offsetX="10" />
                            <Dimensions x="150" y="25" />
                            <OnClicked>LibScanner_SortBy("version")</OnClicked>
                        </Button>
                        <Control name="$(parent)List" inherits="ZO_ScrollList">
                            <Anchor point="TOPLEFT" offsetY="30" />
                            <Anchor point="BOTTOMRIGHT" />
                        </Control>
                    </Controls>
                </Control>
            </Controls>
        </Control>

        <Control name="BasaToolsTweaksPanel" virtual="true">
            <Controls>
                <Label name="$(parent)Intro" font="ZoFontGame" color="CFDCBD">
                    <Anchor point="TOPLEFT" />
                    <Anchor point="TOPRIGHT" />
                    <Dimensions y="24" />
                </Label>
                <Button name="$(parent)CheckOverlay" inherits="ZO_CheckButton">
                    <Anchor point="TOPLEFT" relativeTo="$(parent)Intro" relativePoint="BOTTOMLEFT" offsetY="18" />
                </Button>
                <Button name="$(parent)CheckEelPie" inherits="ZO_CheckButton">
                    <Anchor point="TOPLEFT" relativeTo="$(parent)CheckOverlay" relativePoint="BOTTOMLEFT" offsetY="16" />
                </Button>
                <Button name="$(parent)CheckIcon" inherits="ZO_CheckButton">
                    <Anchor point="TOPLEFT" relativeTo="$(parent)CheckEelPie" relativePoint="BOTTOMLEFT" offsetY="16" />
                </Button>
            </Controls>
        </Control>

        <TopLevelControl name="BasaToolsWindow" hidden="true" mouseEnabled="true" movable="true" clampedToScreen="true" resizeHandleSize="12">
            <Dimensions x="820" y="660" />
            <DimensionConstraints minX="820" minY="500" maxX="1600" maxY="1100" />
            <Anchor point="CENTER" />
            <Controls>
                <Backdrop name="$(parent)BG" inherits="ZO_DefaultBackdrop">
                    <AnchorFill />
                </Backdrop>

                <Label name="$(parent)Title" font="ZoFontWindowTitle" text="BasaTools" color="CFDCBD">
                    <Anchor point="TOPLEFT" offsetX="20" offsetY="10" />
                </Label>
                <Button name="$(parent)CloseHit" mouseEnabled="true">
                    <Anchor point="TOPRIGHT" />
                    <Dimensions x="44" y="44" />
                    <OnClicked>BasaToolsWindow:SetHidden(true)</OnClicked>
                </Button>
                <Button name="$(parent)Close" inherits="ZO_CloseButton">
                    <Anchor point="TOPRIGHT" offsetX="-8" offsetY="8" />
                    <Dimensions x="32" y="32" />
                    <OnClicked>BasaToolsWindow:SetHidden(true)</OnClicked>
                </Button>

                <Texture name="$(parent)HeaderDivider" inherits="ZO_HorizontalDivider">
                    <Anchor point="TOPLEFT" offsetX="20" offsetY="76" />
                    <Anchor point="TOPRIGHT" offsetX="-20" offsetY="76" />
                    <Dimensions y="4" />
                </Texture>

                <Label name="$(parent)OutputLabel" font="ZoFontGame" text="Output">
                    <Anchor point="TOPLEFT" offsetX="20" offsetY="196" />
                </Label>
                <Button name="$(parent)ClearOutput" inherits="ZO_DefaultButton" text="Clear">
                    <Anchor point="TOPRIGHT" offsetX="-20" offsetY="192" />
                    <Dimensions x="90" y="26" />
                    <OnClicked>BasaTools_ClearOutput()</OnClicked>
                    <OnMouseEnter>ZO_Tooltips_ShowTextTooltip(self, TOP, "Clear the output pane.")</OnMouseEnter>
                    <OnMouseExit>ZO_Tooltips_HideTextTooltip()</OnMouseExit>
                </Button>

                <Backdrop name="$(parent)OutputBackdrop" inherits="ZO_MultiLineEditBackdrop_Keyboard">
                    <Anchor point="TOPLEFT" offsetX="20" offsetY="224" />
                    <Anchor point="BOTTOMRIGHT" offsetX="-20" offsetY="-20" />
                    <Controls>
                        <EditBox name="$(parent)Edit" editEnabled="false" inherits="ZO_DefaultEditMultiLineForBackdrop" maxInputCharacters="50000" mouseEnabled="true" />
                        <Control name="$(parent)HelpList" inherits="ZO_ScrollList" hidden="true">
                            <Anchor point="TOPLEFT" offsetX="4" offsetY="4" />
                            <Anchor point="BOTTOMRIGHT" offsetX="-4" offsetY="-20" />
                        </Control>
                        <Slider name="$(parent)HScroll" mouseEnabled="true" orientation="HORIZONTAL" hidden="true">
                            <Dimensions y="12" />
                            <Anchor point="BOTTOMLEFT" offsetX="4" offsetY="-4" />
                            <Anchor point="BOTTOMRIGHT" offsetX="-4" offsetY="-4" />
                            <ThumbTexture
                                textureFile="EsoUI/Art/Miscellaneous/scrollbox_elevator.dds"
                                disabledTextureFile="EsoUI/Art/Miscellaneous/scrollbox_elevator_disabled.dds"
                                thumbWidth="16"
                                thumbHeight="12"
                            />
                        </Slider>
                    </Controls>
                </Backdrop>
            </Controls>
        </TopLevelControl>

        <TopLevelControl name="BasaToolsHudIcon" hidden="true" mouseEnabled="true" movable="true" clampedToScreen="true">
            <Dimensions x="48" y="48" />
            <Anchor point="TOPLEFT" relativeTo="GuiRoot" offsetX="40" offsetY="200" />
            <Controls>
                <Texture name="$(parent)Icon" textureFile="BasaTools/textures/hud.dds">
                    <Anchor point="CENTER" />
                    <Dimensions x="40" y="40" />
                </Texture>
            </Controls>
        </TopLevelControl>
    </Controls>
</GuiXml>
