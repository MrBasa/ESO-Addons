<GuiXml>
    <Controls>
        <Control name="MatLogRow" virtual="true" mouseEnabled="true">
            <Dimensions y="42" />
            <Anchor point="RIGHT" relativeTo="$(parent)" />
            <Controls>
                <Texture name="$(parent)BG" inherits="ZO_ThinListBgStrip" />
                <Texture name="$(parent)Icon" layer="OVERLAY">
                    <Anchor point="LEFT" offsetX="4" />
                    <Dimensions x="26" y="26" />
                </Texture>
                <Label name="$(parent)Item" font="ZoFontGame" wrapMode="ELLIPSIS" verticalAlignment="CENTER">
                    <Anchor point="LEFT" relativeTo="$(parent)Icon" relativePoint="RIGHT" offsetX="8" />
                    <Dimensions x="260" y="40" />
                </Label>
                <Label name="$(parent)Qty" font="ZoFontGame" wrapMode="ELLIPSIS" horizontalAlignment="RIGHT" verticalAlignment="CENTER">
                    <Anchor point="LEFT" relativeTo="$(parent)Item" relativePoint="RIGHT" offsetX="12" />
                    <Dimensions x="56" y="40" />
                </Label>
                <Label name="$(parent)Category" font="ZoFontGame" wrapMode="ELLIPSIS" verticalAlignment="CENTER">
                    <Anchor point="LEFT" relativeTo="$(parent)Qty" relativePoint="RIGHT" offsetX="20" />
                    <Dimensions x="90" y="40" />
                </Label>
                <Label name="$(parent)Character" font="ZoFontGame" wrapMode="ELLIPSIS" verticalAlignment="CENTER">
                    <Anchor point="LEFT" relativeTo="$(parent)Category" relativePoint="RIGHT" offsetX="8" />
                    <Dimensions x="130" y="40" />
                </Label>
                <Control name="$(parent)Value">
                    <Anchor point="TOPLEFT" relativeTo="$(parent)Character" relativePoint="TOPRIGHT" offsetX="8" offsetY="2" />
                    <Anchor point="BOTTOMRIGHT" offsetX="-8" offsetY="-2" />
                    <Controls>
                        <Label name="$(parent)Total" font="ZoFontGame" wrapMode="ELLIPSIS" horizontalAlignment="RIGHT">
                            <Anchor point="TOPLEFT" />
                            <Anchor point="TOPRIGHT" />
                            <Dimensions y="18" />
                        </Label>
                        <Label name="$(parent)Unit" font="ZoFontGameSmall" wrapMode="ELLIPSIS" horizontalAlignment="RIGHT">
                            <Anchor point="BOTTOMLEFT" />
                            <Anchor point="BOTTOMRIGHT" />
                            <Dimensions y="16" />
                        </Label>
                    </Controls>
                </Control>
                <Texture name="$(parent)RowDivider" color="FFFFFF" alpha="0.18">
                    <Anchor point="BOTTOMLEFT" offsetX="8" />
                    <Anchor point="BOTTOMRIGHT" offsetX="-8" />
                    <Dimensions y="1" />
                </Texture>
            </Controls>
        </Control>

        <Control name="MatLogPanel" virtual="true">
            <Controls>
                <Button name="$(parent)Help" inherits="ZO_DefaultButton" text="Help">
                    <Anchor point="TOPLEFT" />
                    <Dimensions x="90" y="28" />
                    <OnClicked>BasaTools_ShowHelp("MatLog")</OnClicked>
                    <OnMouseEnter>ZO_Tooltips_ShowTextTooltip(self, TOP, "What MatLog tracks and how Full / Summary views work.")</OnMouseEnter>
                    <OnMouseExit>ZO_Tooltips_HideTextTooltip()</OnMouseExit>
                </Button>
                <Button name="$(parent)CheckEnable" inherits="ZO_CheckButton">
                    <Anchor point="TOPLEFT" relativeTo="$(parent)Help" relativePoint="TOPRIGHT" offsetX="16" offsetY="2" />
                </Button>
                <Button name="$(parent)CheckSummary" inherits="ZO_CheckButton">
                    <Anchor point="TOPLEFT" relativeTo="$(parent)CheckEnable" relativePoint="TOPLEFT" offsetX="160" />
                </Button>

                <Label name="$(parent)PriceSourceLabel" font="ZoFontGame" text="Price source">
                    <Anchor point="TOPLEFT" relativeTo="$(parent)Help" relativePoint="BOTTOMLEFT" offsetY="10" />
                </Label>
                <Control name="$(parent)PriceSourceDrop" inherits="ZO_ComboBox">
                    <Anchor point="TOPLEFT" relativeTo="$(parent)PriceSourceLabel" relativePoint="TOPRIGHT" offsetX="8" offsetY="-4" />
                    <Dimensions x="160" y="28" />
                </Control>
                <Control name="$(parent)DayDrop" inherits="ZO_ComboBox">
                    <Anchor point="TOPLEFT" relativeTo="$(parent)PriceSourceDrop" relativePoint="TOPRIGHT" offsetX="12" />
                    <Dimensions x="140" y="28" />
                </Control>
                <Control name="$(parent)CharDrop" inherits="ZO_ComboBox">
                    <Anchor point="TOPLEFT" relativeTo="$(parent)DayDrop" relativePoint="TOPRIGHT" offsetX="8" />
                    <Dimensions x="150" y="28" />
                </Control>
                <Control name="$(parent)CategoryDrop" inherits="ZO_ComboBox">
                    <Anchor point="TOPLEFT" relativeTo="$(parent)CharDrop" relativePoint="TOPRIGHT" offsetX="8" />
                    <Dimensions x="140" y="28" />
                </Control>

                <Backdrop name="$(parent)ListBackdrop" inherits="ZO_DefaultBackdrop">
                    <Anchor point="TOPLEFT" relativeTo="$(parent)PriceSourceLabel" relativePoint="BOTTOMLEFT" offsetY="10" />
                    <Anchor point="BOTTOMRIGHT" offsetY="-28" />
                    <Controls>
                        <Control name="$(parent)Headers">
                            <Anchor point="TOPLEFT" offsetX="4" offsetY="2" />
                            <Anchor point="TOPRIGHT" offsetX="-4" />
                            <Dimensions y="32" />
                            <Controls>
                                <Control name="$(parent)Item" inherits="ZO_SortHeader">
                                    <Anchor point="LEFT" offsetX="38" />
                                    <Dimensions x="260" y="32" />
                                </Control>
                                <Control name="$(parent)Qty" inherits="ZO_SortHeader">
                                    <Anchor point="LEFT" relativeTo="$(parent)Item" relativePoint="RIGHT" offsetX="12" />
                                    <Dimensions x="56" y="32" />
                                </Control>
                                <Control name="$(parent)Category" inherits="ZO_SortHeader">
                                    <Anchor point="LEFT" relativeTo="$(parent)Qty" relativePoint="RIGHT" offsetX="20" />
                                    <Dimensions x="90" y="32" />
                                </Control>
                                <Control name="$(parent)Character" inherits="ZO_SortHeader">
                                    <Anchor point="LEFT" relativeTo="$(parent)Category" relativePoint="RIGHT" offsetX="8" />
                                    <Dimensions x="130" y="32" />
                                </Control>
                                <Control name="$(parent)Value" inherits="ZO_SortHeader">
                                    <Anchor point="LEFT" relativeTo="$(parent)Character" relativePoint="RIGHT" offsetX="8" />
                                    <Anchor point="RIGHT" offsetX="-8" />
                                    <Dimensions y="32" />
                                </Control>
                            </Controls>
                        </Control>
                        <Control name="$(parent)List" inherits="ZO_ScrollList">
                            <Anchor point="TOPLEFT" offsetX="4" offsetY="34" />
                            <Anchor point="BOTTOMRIGHT" offsetX="-4" offsetY="-4" />
                        </Control>
                    </Controls>
                </Backdrop>
                <Label name="$(parent)Totals" font="ZoFontGame" wrapMode="ELLIPSIS">
                    <Anchor point="BOTTOMLEFT" />
                    <Anchor point="BOTTOMRIGHT" />
                    <Dimensions y="24" />
                </Label>
            </Controls>
        </Control>
    </Controls>
</GuiXml>
