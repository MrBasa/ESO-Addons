{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "deploy:steam-eso-addons",
      "type": "shell",
      "command": "${workspaceFolder}/scripts/deploy_steam_eso_addons.sh",
      "presentation": {
        "echo": false
      },
      "problemMatcher": []
    },
    {
      "label": "update:eso-api",
      "type": "shell",
      "command": "${workspaceFolder}/scripts/update_eso_api.sh",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "update:eso-api (check only)",
      "type": "shell",
      "command": "${workspaceFolder}/scripts/update_eso_api.sh",
      "args": ["--check"],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "build",
      "type": "shell",
      "dependsOn": ["deploy:steam-eso-addons"],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    }
  ]
}
