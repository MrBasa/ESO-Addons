							</OnInitialized>
							<Anchor point="TOPLEFT" relativePoint="TOPRIGHT" relativeTo="$(parent)Time" />
							<Dimensions x="150" y="32" />
						</Control>
						<Control name="$(parent)Reason" inherits="ZO_SortHeader">
							<OnInitialized>
								ZO_SortHeader_Initialize(self, "From", "reason", ZO_SORT_ORDER_UP, TEXT_ALIGN_LEFT, "ZoFontGameLargeBold")
							</OnInitialized>
							<Anchor point="TOPLEFT" relativePoint="TOPRIGHT" relativeTo="$(parent)Amount" offsetX="25" />
							<Dimensions x="350" y="32" />
						</Control>
						<Control name="$(parent)Recipient" inherits="ZO_SortHeader">
							<OnInitialized>
								ZO_SortHeader_Initialize(self, GetString(SI_LOOTLOG_HEADER_RECIPIENT), "recipient", ZO_SORT_ORDER_UP, TEXT_ALIGN_LEFT, "ZoFontGameLargeBold")
